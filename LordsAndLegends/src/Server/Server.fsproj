<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Npgsql.FSharp 8.0.0 is built against FSharp.Core 9; pin it (and disable
         the SDK's implicit FSharp.Core 8) so the 9.x assembly is the one used.
         9.x is backward compatible, so it also satisfies Fable.Remoting. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Content.fs" />
    <Compile Include="Database.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="FSharp.Core" Version="9.0.100" />
    <!-- Pinned to the .NET 8-compatible line: Fable.Remoting 6.x pulls
         Giraffe 8.x, which targets .NET 9. 5.24.0 uses Giraffe 6.x (net8). -->
    <PackageReference Include="Fable.Remoting.Giraffe" Version="5.24.0" />
    <!-- Fable.Remoting's current binaries reference the .NET 9 build of
         Primitives even on old version numbers; supply it explicitly (it runs
         fine on the net8 runtime) so request handling can load StringValues. -->
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="9.0.0" />
    <PackageReference Include="Npgsql.FSharp" Version="8.0.0" />
    <PackageReference Include="Saturn" Version="0.17.0" />
  </ItemGroup>

</Project>
